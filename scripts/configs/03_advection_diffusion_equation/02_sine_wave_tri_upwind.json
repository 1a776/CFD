{
  "caseName": "02_sine_wave_tri_upwind",
  "solverFamily": "03_advection_diffusion_equation",
  "description": "Third problem, first example: periodic sine-wave advection-diffusion on a structured triangular prism mesh.",
  "equation": "advection_diffusion",
  "problem": "sine_wave_advection_diffusion",
  "meshType": "tri",
  "meshBackend": "gmsh",
  "gmshPython": "/home/a776/vibeflow/python-env/bin/python",
  "schemeName": "Gauss_upwind__Gauss_linear_corrected",
  "divScheme": "Gauss upwind",
  "laplacianScheme": "Gauss linear corrected",
  "snGradScheme": "corrected",
  "solver": "explicitAdvectionDiffusionFoamStudent",
  "resolutions": [10, 20, 40, 80],
  "domain": [0.0, 1.0, 0.0, 1.0],
  "resolutionMeaning": "baseIntervalsPerEdge",
  "scalarField": "phi",
  "velocity": [1.0, 1.0, 0.0],
  "mu": 1.0,
  "boundaryCondition": "periodicXY",
  "postprocess": {
    "type": "exactError",
    "exactSolution": "sineWaveAdvectionDiffusion",
    "reportTime": 1.0,
    "errorDefinition": {
      "primaryMetric": "initialFieldNormalized",
      "secondaryMetrics": ["absolute"],
      "legacyMetric": "exactFieldNormalized",
      "legacyValidThreshold": "exactNorm > initialNorm * 1e-12",
      "convergenceOrderMetric": "initialFieldNormalized",
      "reason": "At mu=1 and t=1 the exact amplitude is exp(-8*pi^2)=5.1225e-35."
    }
  },
  "endTime": 1.0,
  "advectionDiffusionCo": 0.45,
  "maxDeltaT": 0.001,
  "thickness": 0.1,
  "implemented": true
}
