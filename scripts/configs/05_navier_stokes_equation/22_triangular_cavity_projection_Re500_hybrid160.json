{
  "caseName": "22_triangular_cavity_projection_Re500_hybrid160",
  "solverFamily": "05_navier_stokes_equation",
  "solver": "projectionFoamStudent",
  "problem": "tri_lid_driven_cavity",
  "description": "第五题第二个算例：等边三角形顶盖驱动腔流，投影法，Re=500，混合网格 N=160。",
  "reynolds": 500,
  "viscosity": 0.002,
  "meshType": "hybrid",
  "meshBackend": "gmsh",
  "meshLevel": "hybrid160",
  "resolutions": [160],
  "cellsPerEdge": 160,
  "boundaryLayerThickness": 0.1,
  "boundaryLayerCount": 16,
  "thickness": 0.1,
  "deltaT": 0.00025,
  "endTime": 140.0,
  "adjustTimeStep": true,
  "maxCo": 0.2,
  "maxDeltaT": 0.01,
  "writeInterval": 1.0,
  "divScheme": "Gauss linearUpwind grad(U)",
  "laplacianScheme": "Gauss linear corrected",
  "snGradScheme": "corrected",
  "nCorrectors": 2,
  "nNonOrthogonalCorrectors": 1,
  "linearTolerance": 1e-8,
  "steadyStateControl": true,
  "steadyVelocityTol": 1e-6,
  "steadyMassTol": 1e-8,
  "minimumSteadySteps": 1000,
  "requiredSteadySteps": 20,
  "boundaryCondition": "triangularLidNoSlip",
  "postprocess": {
    "reference": "Kohno2006_Erturk2007",
    "centerline": "u(0,y)",
    "horizontalLine": "v(x,-1)",
    "streamfunction": true,
    "vorticity": true,
    "vortices": true
  }
