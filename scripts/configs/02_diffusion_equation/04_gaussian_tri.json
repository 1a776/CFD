{
  "caseName": "04_gaussian_tri",
  "solverFamily": "02_diffusion_equation",
  "description": "Gaussian diffusion benchmark on a structured triangular mesh.",
  "equation": "diffusion",
  "problem": "diffusion_gaussian",
  "meshType": "tri",
  "meshBackend": "gmsh",
  "schemeName": "Gauss_linear_corrected",
  "laplacianScheme": "Gauss linear corrected",
  "snGradScheme": "corrected",
