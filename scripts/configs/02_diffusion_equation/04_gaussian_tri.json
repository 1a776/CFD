  "boundaryCondition": "gaussianDirichlet",
  "postprocess": {
    "type": "exactError",
    "exactSolution": "gaussianDiffusion",
    "reportTime": 0.2
  },
  "endTime": 0.2,
  "diffusionCo": 0.45,
  "maxDeltaT": 0.001,
  "thickness": 0.1,
  "implemented": true
