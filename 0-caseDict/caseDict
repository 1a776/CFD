    caseName           training_examples_incomp_suite;
    displayName        "Numerical PDE tests from training_examples_incomp.pdf";
    description        "Unified solver-neutral definition for the five PDE test problems and their numerical subcases.";
    owner              a776;
    project            student_project;
    revision           1.0;
    status             readyForReport;
    discipline         fluid;
    analysisType       parametric;
    dimensions         2D;
    fidelity           validation;
    executionProfile   local;
    tags               (PDE finiteVolume OpenFOAM trainingExamples incompressible);
    notes              "The project is a suite of scalar PDE and incompressible-flow benchmarks; solver-specific files remain under cases/ and UDF/.";

    units
    {
        length           m;
        mass             kg;
        time             s;
        temperature      K;
        angle            rad;
