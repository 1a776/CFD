extensions
{
    sourceDocument       pdf/training_examples_incomp.pdf;
    projectParameterSource "scripts/configs/*.json";
    caseStudies
    {
        problem01_advection
        {
            equation          "dphi/dt + div(U*phi) = 0";
            objectives        (explicitFiniteVolumeSolver L1Error convergenceRate finalContour);
            sineWave
            {
                domain          "[0,1] x [0,1]";
                initial         "phi0=sin(2*pi*(x+y))";
                velocity        "U=(1,1,0)";
                boundary        periodicXY;
                resolutions     (10 20 40 80);
                time            "t=1";
                maxCo           0.2;
                meshTypes       (quad tri);
                acceptance      (finiteL1AtT1 observedOrder meshOK solverEnded solverFatalFalse);
            }
            solidRotation
            {
                domain          "[0,1] x [0,1]";
                velocity        "U=(0.5-y,x-0.5,0)";
                boundary        zeroScalarAtOuterBoundary;
                nominalResolution "100 vertices per edge in PDF; project uses N=100 cellsPerEdge and extends to N=50,100,200";
                resolutions     (50 100 200);
                time            "t=2*pi";
                maxCo           0.2;
                profile         "parameterized slotted disk + cone + smooth hump";
                acceptance      (finalContourAfterOneRevolution meshOK solverEnded solverFatalFalse);
            }
            assumptions       (explicitForwardEuler firstOrderUpwind optionalLinearUpwind thinPrism);
            artifacts         (scripts/configs/01_advection_equation cases/01_advection_equation data/01_advection_equation figures/01_advection_equation report/01_advection_equation);
        }

        problem02_diffusion
        {
            equation          "dphi/dt - div(mu*grad(phi)) = 0";
            objectives        (explicitFiniteVolumeSolver L1Error L2Error LinfError convergenceRate scalarMass);
            common
            {
                domain          "[-5,5] x [-5,5]";
                mu              1;
                resolutions     (10 20 40 80);
                time            "t=0.2";
                meshTypes       (quad tri);
                acceptance      (finiteNorms decreasingTrend meshOK solverEnded solverFatalFalse);
            }
            discontinuity
            {
                initial         "phi=1 for |x|<=1 and |y|<=1; otherwise 0";
                exactSolution   "product of one-dimensional error-function solutions";
                boundary        homogeneousNeumann;
            }
            gaussian
            {
                initial         "phi=exp(-mu*(x^2+y^2))";
                exactSolution   "phi=(1+4*mu*t)^(-1)*exp(-mu*(x^2+y^2)/(1+4*mu*t))";
                boundary        analyticDirichlet;
                assumption      "Interpret PDF radial variable as r2=x2+y2.";
            }
            numerical         (explicitForwardEuler GaussLinearCorrected diffusionCo0.45 maxDeltaT0.001);
            artifacts         (scripts/configs/02_diffusion_equation cases/02_diffusion_equation data/02_diffusion_equation figures/02_diffusion_equation report/02_diffusion_equation);
        }

        problem03_advectionDiffusion
        {
            equation          "dphi/dt + div(U*phi) - div(mu*grad(phi)) = 0";
            objectives        (explicitFiniteVolumeSolver absoluteError normalizedError convergenceRate finalContour);
            sineWave
            {
                domain          "[0,1] x [0,1]";
                initial         "phi0=sin(2*pi*(x+y))";
                velocity        "U=(a,a,0), project a=1";
                mu              1;
                boundary        periodicXY;
                time            "t=1";
                resolutions     (10 20 40 80);
                exactSolution   "exp(-8*pi^2*mu*t)*sin(2*pi*(x+y-2*a*t))";
                errorDefinition
                {
                    primary      initialFieldNormalized;
                    secondary    absolute;
                    legacy       exactFieldNormalized;
                    legacyValidThreshold "exact norm > initial norm * 1e-12";
                    convergenceOrder primary;
                    invalidLegacyCases true;
                }
            }
            rotatingPeak
            {
                domain          "[-1,1] x [-1,1]";
                initial         "rotating Gaussian peak started at t0=pi/2";
                velocity        "U=(-y,x,0)";
                epsilon         0.001;
                center          "(x0,y0)=(0,0.5)";
                centerMotion    "xhat=x0*cos(t)-y0*sin(t); yhat=x0*sin(t)+y0*cos(t)";
                boundary        analyticOrZeroDirichlet;
                time            "one round rotation; project endTime=2*pi";
                resolutions     (20 40 80);
                errorDefinition
                {
                    primary      exactFieldNormalized;
                    secondary    absolute;
                    convergenceOrder exactFieldNormalized;
                }
            }
            assumptions       (explicitForwardEuler upwindAdvection correctedLaplacian thinPrism);
            artifacts         (scripts/configs/03_advection_diffusion_equation cases/03_advection_diffusion_equation data/03_advection_diffusion_equation figures/03_advection_diffusion_equation);
        }

        problem04_poisson
        {
            equation          "laplacian(phi) = omega";
            objectives        (solutionField L1Error L2Error LinfError convergenceRate);
            domain            "[0,1] x [0,1]";
            exactSolution     "phi=cos(pi*x)*cos(pi*y)";
            source            "omega=-2*pi^2*cos(pi*x)*cos(pi*y)";
            boundary          manufacturedDirichlet;
            resolutions       (10 20 40 80);
            meshTypes         (quad tri);
            spatialMethod     OpenFOAMFiniteVolumeLaplacian;
            linearSolver      GAMG;
            linearTolerance   1e-12;
            nNonOrthogonalCorrectors 2;
            time              "steady; endTime=0";
            acceptance        (meshOK solverEnded solverFatalFalse decreasingError observedOrderNearTwo logsPresent meshPresent formalReportPresent);
            artifacts         (scripts/configs/04_poisson_equation cases/04_poisson_equation data/04_poisson_equation figures/04_poisson_equation report/04_poisson_equation);
        }

        problem05_navierStokes
        {
            equations        ("div(U)=0" "dU/dt + div(U tensor U) = -grad(p)/rho + div(nu*grad(U))");
            objectives        (steadyVelocityField streamlines centerlineProfiles referenceComparison);
            common
            {
                fluid            benchmarkFluid;
                density          1;
                lidVelocity      "U=1";
                boundary         "no-slip walls except moving top wall";
                numericalMethods (projection PISO);
                meshTopology     hybridUnstructured;
            }
            squareCavity
            {
                domain           "[0,1] x [0,1]";
                characteristicLength 1;
                reynoldsNumbers  (1000 3200 5000);
                viscosity        "nu=1/Re";
                references       (Ghia1982 Ghia1992);
                acceptance       (steadyState streamlines uCenterline vCenterline referenceComparison);
            }
            triangularCavity
            {
                geometry         equilateralTriangle;
                characteristicLength 1;
                reynoldsNumbers  (100 200 500);
                viscosity        "nu=1/Re";
                boundary         "left and right no-slip; top wall U=1";
                references       (Kohno2006 Erturk2007 Jagannathan2014 Ribbens1994);
                acceptance       (steadyState streamlines centerlineProfiles vortexLocations referenceComparison);
            }
            status             "Triangular-cavity hybrid80 subset checked; full PDF matrix remains partial.";
            artifacts          (scripts/configs/05_navier_stokes_equation cases/05_navier_stokes_equation data/05_navier_stokes_equation figures/05_navier_stokes_equation);
        }
    }
}

