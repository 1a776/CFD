{
    formulation         finiteVolume;
    spatialOrder        mixedFirstAndSecondOrder;
    temporalOrder       firstOrderExplicitOrSteadyLinearSolve;
    linearization       mixedExplicitAndSegregated;
    stabilization       upwindAndNonOrthogonalCorrection;
    nonlinearSolver     fixedPoint;
    linearSolver        iterativeMultigridOrKrylov;
    preconditioner      GAMGOrOpenFOAMDefault;
    convergenceCriteria "case-specific residual, steady-state, error, and conservation checks";
    conservationChecks  (massOrScalarBalance divergenceAndBoundedness meshQuality);

    timeControl
    {
        startTime          0;
        endTime            "case dependent";
        timeStep           "case dependent";
        adaptiveTimeStep   true;
        maxCourant         "0.2 for advection; 0.45 for diffusion/advection-diffusion; 0.2 for cavity cases";
        outputInterval     "case dependent";
    }

    parallel
    {
        enabled            false;
        subdomains         1;
        decomposition      automatic;
    }
}

execution
{
    runMode              serial;
    preprocessingSteps   (generateOrImportMesh initializeFields checkMesh);
    solveSteps           (runConfiguredStudentSolver collectLogs);
    restartPolicy        none;
    monitoring           (residuals CFL divergence finalTime solverFatal meshQuality);
    generatedInputs      (scripts/configs cases/*/Allrun cases/*/Allclean);
    logs                 "case-local log.* and run.batch.log";
    artifacts            (data figures report);
}

