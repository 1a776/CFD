{
    objectives
    {
        primaryMetrics    (L1 L2 Linf observedOrder absoluteError initialNormalizedError scalarMassError velocityRMSE vortexLocation);
        secondaryMetrics  (finalAmplitude finalFieldRange CFL timeSteps residualIntegral);
        comparisonTargets (analyticalSolution GhiaCenterline triangularCavityReferences requirement);
    }

    dataExtraction
    {
        lineSamples        (uCenterline vCenterline triangularCenterline);
        volumeAverages     (scalarMass errorNorms);
        formulas           "p=log(E_N/E_2N)/log(2) for N doubling";
    }

    visualization
    {
        fieldScenes        (fieldComparison contourFinal streamlines vorticity streamfunction);
        meshViews           (meshQuality boundaryLayers);
        animations          none;
    }

    derivedQuantities
    {
        formulas           (absoluteNorms initialFieldNormalizedNorms exactFieldNormalizedNorms velocityRMSE vortexPositionError);
        referenceValues    (analyticalSolutions Ghia1992 Ghia1982 triangularCavityLiterature);
        uncertainty        "Use explicit limitations when the exact/reference normalization or post-processing reconstruction is not valid.";
    }

    artifacts
    {
        csv                (data/01_advection_equation data/02_diffusion_equation data/03_advection_diffusion_equation data/04_poisson_equation data/05_navier_stokes_equation);
        images             (figures/01_advection_equation figures/02_diffusion_equation figures/03_advection_diffusion_equation figures/04_poisson_equation figures/05_navier_stokes_equation);
