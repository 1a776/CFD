intent
{
    userIntent         "Implement, verify, and document the five numerical PDE problems in training_examples_incomp.pdf.";
    targetOutputs      (solverCapability numericalErrors convergenceRates finalFields contours streamlines centerlineProfiles meshQuality runtimeLogs formalReports);
    acceptanceCriteria (equationsAndParametersTraceable stableTimeIntegration meshOK solverEndsWithoutFatalError errorDefinitionTraceable errorsDecreaseWhenMeaningful requiredFiguresAndTablesReportable);
    primaryAssumptions (twoDimensionalLaminarIncompressibleConstantProperties finiteVolumeOpenFOAM14 thinExtrusionForOpenFOAM);
    knownLimitations (thirdProblemSineWaveAtMu1T1HasNearZeroExactNorm fifthProblemMatrixIsNotComplete firstProblemComplexProfileIsFigureReconstructed);
    openQuestions (exactSolidRotationProfileParameters exactInterpretationOfPdfVertexCount completeFifthProblemParameterMatrix);
    decisionLog
    (
        "Use the PDF as the original problem source and retain existing project JSON configurations as generated-case records."
        "Use solver-neutral definitions here; OpenFOAM dictionaries are derived artifacts."
        "For third-problem sine-wave diffusion, use absolute error and initial-field-normalized error as primary metrics because the exact final norm is approximately 5.12e-35."
        "Interpret the second diffusion problem as the standard Gaussian solution with r2=x2+y2."
        "Interpret the first diffusion Neumann boundary as homogeneous Neumann."
        "Treat the first-problem solid-rotation profile as a parameterized reconstruction because the PDF provides the profile mainly by figure."
    );
}

