FoamFile
{
    format ascii;
    class dictionary;
    location "system";
    object fvSchemes;
}
ddtSchemes { default Euler; }
gradSchemes
{
    default Gauss linear;
}
divSchemes
{
    default none;
    div(phi,T) Gauss upwind;
    div(faceFlux,phi) Gauss upwind;
}
laplacianSchemes
{
    default none;
    laplacian(mu,phi) Gauss linear corrected;
}
interpolationSchemes
{
    default linear;
}
snGradSchemes
{
    default corrected;
}
