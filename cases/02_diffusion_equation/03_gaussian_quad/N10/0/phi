        #{ 
            const scalar t = this->db().time().value();
            const scalar denom = 1.0 + 4.0*t;
            const scalar invDenom = 1.0/denom;
            const scalar mu = 1;
            const vectorField& Cf = patch().Cf();
            scalarField values(patch().size(), 0.0);
            forAll(Cf, i)
