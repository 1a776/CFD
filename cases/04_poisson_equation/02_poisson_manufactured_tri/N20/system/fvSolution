FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    // 对应数学方程组：
    //     A phi = b
    //
    // poissonFoamStudent 中的：
    //     phiEqn.solve()
    //
    // 会读取这里的线性求解器和容差。
    phi
    {
        solver          GAMG;
        tolerance       1e-12;
        relTol          0;
        smoother        GaussSeidel;
    }
}
