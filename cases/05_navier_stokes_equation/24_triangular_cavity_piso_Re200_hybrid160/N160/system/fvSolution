FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

PISO
{
    // 第五题 PISO 参数入口。
    nCorrectors 2;
    nNonOrthogonalCorrectors 1;
    pRefCell 0;
    pRefValue 0;
    momentumPredictor yes;
}

solvers
{
    U
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-08;
        relTol 0;
    }

    p
    {
        solver GAMG;
        tolerance 1e-08;
        relTol 0;
        smoother GaussSeidel;
    }

    pFinal
    {
        $p;
        relTol 0;
    }
}
