FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      createPatchDict;
}

pointSync false;
writeCyclicMatch false;

patches
{
    front
    {
        patchInfo { type empty; }
        constructFrom patches;
        patches (frontSource);
    }
    back
    {
        patchInfo { type empty; }
        constructFrom patches;
        patches (backSource);
    }
}
