FoamFile
{
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    xMin
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          10;
        startFace       180;
        matchTolerance  0.0001;
        neighbourPatch  xMax;
        transformType   translational;
        separation      (-1 0 0);
    }
    xMax
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          10;
        startFace       190;
        matchTolerance  0.0001;
        neighbourPatch  xMin;
        transformType   translational;
        separation      (1 0 0);
    }
    yMin
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          10;
        startFace       200;
        matchTolerance  0.0001;
        neighbourPatch  yMax;
        transformType   translational;
        separation      (0 -1 0);
    }
    yMax
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          10;
        startFace       210;
        matchTolerance  0.0001;
        neighbourPatch  yMin;
        transformType   translational;
        separation      (0 1 0);
    }
    zMin
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          100;
        startFace       220;
    }
    zMax
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          100;
        startFace       320;
    }
)

